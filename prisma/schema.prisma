generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  name      String
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions  Submission[]  @relation("SubmissionAuthor")
  decisions    Decision[]    @relation("DecisionDecider")
  feedbacks    Feedback[]    @relation("FeedbackAuthor")
  journals     Journal[]     @relation("JournalEditor")
  participants Participant[]

  @@map("users")
}

model Journal {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  description     String
  editorInChiefId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  editorInChief User         @relation("JournalEditor", fields: [editorInChiefId], references: [id])
  issues        Issue[]
  submissions   Submission[]

  @@map("journals")
}

model Issue {
  id          String    @id @default(uuid(7)) @db.Uuid
  journalId   String    @db.Uuid
  volume      Int
  number      Int
  title       String?
  description String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  journal      Journal       @relation(fields: [journalId], references: [id])
  publications Publication[]

  @@map("issues")
}

model Submission {
  id        String           @id @default(uuid(7)) @db.Uuid
  journalId String           @db.Uuid
  authorId  String           @db.Uuid
  title     String
  abstract  String
  authors   Json
  status    SubmissionStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  journal      Journal       @relation(fields: [journalId], references: [id])
  author       User          @relation("SubmissionAuthor", fields: [authorId], references: [id])
  revisions    Revision[]
  decisions    Decision[]
  feedbacks    Feedback[]
  participants Participant[]
  publication  Publication?

  @@map("submissions")
}

model Revision {
  id           String        @id @default(uuid(7)) @db.Uuid
  submissionId String        @db.Uuid
  file         String?
  version      Int
  startStage   RevisionStage @default(DRAFT)
  currentStage RevisionStage @default(DRAFT)
  isFrozen     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submission  Submission   @relation(fields: [submissionId], references: [id])
  decisions   Decision[]
  feedbacks   Feedback[]
  publication Publication?

  @@unique([submissionId, version])
  @@map("revisions")
}

model Decision {
  id           String        @id @default(uuid(7)) @db.Uuid
  submissionId String        @db.Uuid
  revisionId   String        @db.Uuid
  deciderId    String        @db.Uuid
  startStage   RevisionStage
  decidedStage RevisionStage
  comment      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  revision   Revision   @relation(fields: [revisionId], references: [id])
  decider    User       @relation("DecisionDecider", fields: [deciderId], references: [id])

  @@map("decisions")
}

model Feedback {
  id             String                 @id @default(uuid(7)) @db.Uuid
  submissionId   String                 @db.Uuid
  revisionId     String                 @db.Uuid
  authorId       String                 @db.Uuid
  file           String?
  content        String
  stage          FeedbackStage
  recommendation FeedbackRecommendation
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  revision   Revision   @relation(fields: [revisionId], references: [id])
  author     User       @relation("FeedbackAuthor", fields: [authorId], references: [id])

  @@map("feedbacks")
}

model Publication {
  id           String    @id @default(uuid(7)) @db.Uuid
  issueId      String    @db.Uuid
  revisionId   String    @unique @db.Uuid
  submissionId String    @unique @db.Uuid
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  issue      Issue      @relation(fields: [issueId], references: [id])
  revision   Revision   @relation(fields: [revisionId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])

  @@unique([issueId, submissionId])
  @@map("publications")
}

model Participant {
  id           String        @id @default(uuid(7)) @db.Uuid
  submissionId String        @db.Uuid
  userId       String        @db.Uuid
  stage        RevisionStage
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@map("participants")
}

enum Role {
  AUTHOR
  REVIEWER
  EDITOR
  ADMINISTRATOR

  @@map("role")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEW
  EDIT
  COPY_EDIT
  LAYOUT_EDIT
  FINAL_REVIEW
  PUBLISHED
  REJECTED
  WITHDRAWN

  @@map("submission_status")
}

enum RevisionStage {
  DRAFT
  SUBMITTED
  REVIEW
  EDIT
  COPY_EDIT
  LAYOUT_EDIT
  FINAL_REVIEW
  PUBLISHED
  REJECTED
  WITHDRAWN

  @@map("revision_stage")
}

enum FeedbackRecommendation {
  CONTINUE
  REJECT
  REVISE

  @@map("feedback_recommendation")
}

enum FeedbackStage {
  REVIEW
  EDIT
  COPY_EDIT
  LAYOUT_EDIT
  FINAL_REVIEW

  @@map("feedback_stage")
}
